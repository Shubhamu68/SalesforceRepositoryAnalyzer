# Local example only. Copy to .env and supply your actual paths.
# This source repository is required when the Express backend starts.
SALESFORCE_REPOSITORY_PATH=C:/Work/SalesforceRepo

# Optional. If missing or invalid, clicking Run SOQL Analysis opens the
# one-time Windows folder picker and the backend saves the selected path.
# SALESFORCE_ANALYZER_OUTPUT_DIRECTORY=C:/Users/YourUser/Desktop/SF-Reports

# Optional live-org verification settings. Use approved org credentials.
SALESFORCE_LOGIN_URL=https://test.salesforce.com
SALESFORCE_API_VERSION=v62.0
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
