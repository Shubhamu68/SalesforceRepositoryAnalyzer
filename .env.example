# Optional: the Analyzer prompts for a valid Salesforce repository on first launch.
# Must point to the root containing force-app/main/default.
# SALESFORCE_REPOSITORY_PATH=C:/Work/SalesforceRepo

# Optional: SOQL analysis prompts for an Excel output directory when missing.
# SALESFORCE_ANALYZER_OUTPUT_DIRECTORY=C:/Users/YourUser/Desktop/SF-Reports

# Optional live-org verification for SOQL Security Analysis and Stack Trace.
# If ID/secret are missing, a warning allows repository-only checks.
# If both are configured but authentication fails, these two analyses are blocked.
SALESFORCE_LOGIN_URL=https://test.salesforce.com
SALESFORCE_API_VERSION=v62.0
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
