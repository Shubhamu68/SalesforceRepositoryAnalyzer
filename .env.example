# Choose the Salesforce repository and report output paths on first run.
# SALESFORCE_REPOSITORY_PATH=C:/Work/SalesforceRepo
# SALESFORCE_ANALYZER_OUTPUT_DIRECTORY=C:/Users/You/Documents/AnalyzerReports

# Salesforce org authentication uses each developer's Salesforce CLI browser
# session (sf org login web). No shared client secret, app configuration,
# username or password is stored in the Analyzer.
# Install Salesforce CLI and choose Sandbox, Production, or a saved CLI org.
SALESFORCE_API_VERSION=v62.0

# Optional LOCAL, per-org metadata caches. Not required for normal operation.
# When disconnected, the explicit org ID must match the cache's source org.
# Never commit exported field/relationship metadata to the Analyzer repository.
# FIELD_PERMISSIONABILITY_SNAPSHOT_PATH=C:/LocalAnalyzerMetadata/fields.local.json
# SALESFORCE_RELATIONSHIP_SNAPSHOT_PATH=C:/LocalAnalyzerMetadata/relationships.local.json
# FIELD_METADATA_OFFLINE_ORG_ID=00D000000000000
