# Copy to .env, then customize for your own machine. Never commit real secrets.
# Analyzer requires a checked-out Salesforce metadata repository with force-app/main/default.
SALESFORCE_REPOSITORY_PATH=C:/Work/SalesforceRepo

# Excel (XLSX), TXT and scoped analysis JSON output folder.
# Absolute Windows path example: C:/Users/YourUser/Desktop/SalesforceAnalyzerOutputReports
# Relative path example: reports (relative to the Analyzer's root when started there)
SALESFORCE_ANALYZER_OUTPUT_DIRECTORY=reports

# Optional: org-backed verification requires an approved Salesforce External Client App.
SALESFORCE_LOGIN_URL=https://test.salesforce.com
SALESFORCE_API_VERSION=v62.0
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
