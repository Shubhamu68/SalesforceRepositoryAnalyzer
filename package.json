{
  "name": "salesforce-repository-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Static analyzer for Salesforce repositories",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "analyze": "tsx src/index.ts",
    "api": "tsx src/api/server.ts",
    "test:matrix": "tsx --test tests/objectAccessMatrix.test.ts",
    "import:field-metadata": "node scripts/import-field-permissionability.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1"
  }
}
